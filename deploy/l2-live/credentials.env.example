# Copy to var/l2-live/credentials.env. This runtime directory is ignored by Git.
# Use your existing private subscription. Do not use the provider's public test accounts.
ALIYUN_L2_USERNAME=
ALIYUN_L2_PASSWORD=
# Optional overrides; the client ID is always the subscription username.
ALIYUN_L2_BROKER=lv2.base32.cn
ALIYUN_L2_PORT=1883
