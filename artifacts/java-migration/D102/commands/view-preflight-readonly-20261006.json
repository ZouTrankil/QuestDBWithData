  "formal": {
    "view": [
      {
        "view_name": "v_etf_market_overview_daily",
        "view_sql": "SELECT\n    s.timestamp AS trade_date,\n    count_distinct(s.ts_code) AS etf_count,\n    sum(s.fd_share) AS total_share,\n    sum(s.fd_share * d.close) / 10000.0 AS total_size_yi\nFROM etf_share s\nJOIN etf_daily d ON s.ts_code = d.ts_code AND s.timestamp = d.timestamp\n\nSAMPLE BY 1d ALIGN TO CALENDAR",
        "view_table_dir_name": "v_etf_market_overview_daily~239",
        "invalidation_reason": null,
        "view_status": "valid",
