.gradle/
build/
.env
/var/
*.log
/logs/
.idea/
*.iml

# Per-attempt migration captures are local scratch; keep task-level reviews/results.
/artifacts/java-migration/D004/*-*/
/artifacts/java-migration/D005/*-*/
/artifacts/java-migration/D006/*-*/
/artifacts/java-migration/D006/job-*.json

# Large local readback/source snapshots; compact summaries live beside them.
/artifacts/java-migration/D004/merge-readonly.json
/artifacts/java-migration/D004/read-live.json
/artifacts/java-migration/D004/source-preflight.json
/artifacts/java-migration/D005/physical-baseline.json
/artifacts/java-migration/D005/read-live.json
/artifacts/java-migration/D005/storage-readback.json

# SQLite ledgers and their transient WAL/shared-memory files are local run state.
/artifacts/java-migration/D004/**/*.sqlite*
/artifacts/java-migration/D005/**/*.sqlite*
/artifacts/java-migration/D006/**/*.sqlite*

# Runtime databases and locks are local run state across migration tasks.
/artifacts/java-migration/**/*.sqlite*
/artifacts/java-migration/**/*.lock

# Compiler output captured during local migration work.
/artifacts/main-strategy-java-refresh/20261007/shared-native-port-compile/

# Python bytecode caches.
__pycache__/
*.py[cod]
